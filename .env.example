# ── Reasoning Engine ─────────────────────────────────────────────────────────
# Resource name completo del agente en Vertex AI Agent Engine. Lo encuentras en
# la consola de Google Cloud o con `gcloud ai reasoning-engines list`.
# Formato: projects/{proyecto}/locations/{region}/reasoningEngines/{id}
GOOGLE_AGENT_ENGINE_ID=projects/123456789/locations/us-central1/reasoningEngines/111111373185548288

# Nombre para mostrar en la consola (opcional).
GOOGLE_AGENT_DISPLAY_NAME=Reasoning Engine

# class_method que se invoca en :streamQuery (opcional). Los agentes de ADK
# (AdkApp) exponen "async_stream_query" (el valor por defecto) y el alias
# deprecado "stream_query".
GOOGLE_AGENT_STREAM_METHOD=async_stream_query

# ── Login con Google ─────────────────────────────────────────────────────────
# No hay ninguna variable de entorno para esto, y a propósito: nunca usamos una
# llave JSON. La app se autentica con Application Default Credentials (ADC),
# que se resuelven solas según dónde corra:
#
#   - En Cloud Run: usa automáticamente la cuenta de servicio adjunta al
#     servicio. Solo dale el rol `roles/aiplatform.user` a esa cuenta.
#   - En tu máquina: usa la sesión de
#       gcloud auth application-default login
#     Corre ese comando una vez y listo.
#
# La barra de estado de la app muestra con qué identidad quedó autenticada.

# ── Identidad del usuario final (IAP) ───────────────────────────────────────
# Cloud Run está detrás de Identity-Aware Proxy (IAP), así que cada usuario ya
# inició sesión con su cuenta de Google antes de llegar a la app. Usamos su
# correo verificado como userId para que Memory Bank guarde memorias por
# persona (y no un ID aleatorio distinto en cada visita).
#
# No hay nada que configurar aquí: el "audience" para verificar el JWT de IAP
# se calcula solo, preguntándole al metadata server de Cloud Run en qué
# proyecto/región/servicio está corriendo. Por eso esta plantilla funciona
# igual sin cambios en cualquier proyecto donde la despliegues.
#
# IAP_AUDIENCE (opcional): solo hace falta si NO usas el IAP nativo de Cloud
# Run (ej. un Load Balancer externo con IAP delante). En ese caso, cópialo de
# la consola: Seguridad → Identity-Aware Proxy → ⋮ junto al recurso →
# "Signed Header JWT Audience".
# IAP_AUDIENCE=/projects/{numero_de_proyecto}/locations/{region}/services/{nombre_del_servicio}

# Si no hay header de IAP (ej. corriendo `next dev` en tu máquina), la app cae
# de vuelta a un userId aleatorio por sesión.
